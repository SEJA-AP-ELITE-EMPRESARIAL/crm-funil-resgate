# === Conecta_CRM — env de produção (VPS) ===
# Na VPS: copie para a RAIZ do repo como  .env  e ajuste.
#   cp deploy/.env.prod.example .env
# NUNCA commitar o .env real. chmod 600.

DJANGO_DEBUG=false

# Gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=troque-por-uma-chave-forte

# Domínio que serve o app (+ loopback do healthcheck)
DJANGO_ALLOWED_HOSTS=conecta-crm.sejaap.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://conecta-crm.sejaap.com.br

# O nginx do host + Cloudflare já forçam HTTPS → desliga o redirect interno
# (evita loop no healthcheck que bate em http://localhost).
SECURE_SSL_REDIRECT=false

# Front e API são a MESMA origem (nginx proxya /api) → CORS quase irrelevante,
# mas deixamos explícito por segurança.
CORS_ALLOWED_ORIGINS=https://conecta-crm.sejaap.com.br

# Banco: funil-postgres na VPS db-sejaap, alcançado pelo serviço `db-tunnel`
# do compose (autossh). O host `db-tunnel` só existe dentro da rede do compose —
# a porta 5434 do banco continua fechada para a internet.
# Troque SENHA pela senha real do role funil_app.
DATABASE_URL=postgresql://funil_app:SENHA@db-tunnel:5434/funil_vendas
DB_SSLMODE=require

# === Login central (Conecta ID) ===
# A senha passa a ser verificada no serviço identidade-api, que roda nesta mesma
# VPS e NÃO publica porta: o backend o alcança pela rede docker identidade-net
# (ver docker-compose.yml).
#
# Deixe false até ter rodado `vincular_identidades` e conferido o relatório de
# quem não casou. Virar a chave antes disso deixa essa gente do lado de fora.
AUTH_CENTRAL_ATIVO=false
IDENTIDADE_URL=http://identidade-api:8000
# Emitida no Conecta ID e mostrada UMA única vez:
#   docker exec identidade-api python manage.py cadastrar_aplicacao crm --emitir-chave
# Formato: AppKey crm:<segredo>
IDENTIDADE_APP_KEY=
# Segundos. A chamada mais cara é um Argon2 (~60ms); um valor alto aqui viraria
# fila de gunicorn presa esperando um serviço que já caiu.
IDENTIDADE_TIMEOUT=5

# Cota por chave de API de integração (formato do DRF)
CRM_API_RATE=120/min

# Regras de negócio
CRM_COMISSAO_RATE=0.03
CRM_MESES_CONTRATO_PADRAO=12
